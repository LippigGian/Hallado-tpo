# Puerto HTTP de la API. Expo utiliza otro puerto.
PORT=3000
# Vacío hasta disponer de PostgreSQL. No poner credenciales reales en este archivo.
DATABASE_URL=
# Ejemplo de formato (reemplazar valores en .env):
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@localhost:5432/hallado
# Para una base alojada, usar la URL y opciones TLS que indique el proveedor.

# Registro: generar un secreto aleatorio de al menos 32 caracteres y compartirlo solo por privado.
OTP_SECRET=
# disabled | console (solo desarrollo, imprime OTP localmente) | smtp
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Firma de sesiones JWT (secreto distinto del OTP_SECRET, al menos 32 caracteres).
JWT_SECRET=

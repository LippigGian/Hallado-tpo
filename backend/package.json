{
  "name": "hallado-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "db:check": "node --env-file-if-exists=.env src/check-db.js",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.js",
    "test:registration": "node --env-file-if-exists=.env scripts/check-registration.js",
    "test:login": "node --env-file-if-exists=.env scripts/check-login.js",
    "test:recovery": "node --env-file-if-exists=.env scripts/check-recovery.js",
    "test:profiles": "node --env-file-if-exists=.env scripts/check-profiles.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1"
  }
}
